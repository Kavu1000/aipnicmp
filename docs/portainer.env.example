# Portainer stack environment — template
#
# Copy this into Portainer → Stacks → your stack → Environment variables →
# "Advanced mode", then replace the placeholders. Do NOT commit a filled-in
# copy: it holds the database password.
#
# Rules Portainer will not warn you about:
#
#   * No quotes. Portainer stores the value literally, so "secret" arrives as
#     the seven characters including the quote marks, and authentication fails
#     with a password that looks correct in the UI.
#   * No spaces around "=".
#   * No trailing spaces — invisible, and part of the value.
#   * A literal "$" in a value must be written "$$", because compose treats a
#     single "$" as the start of a variable reference.

# --- Required -------------------------------------------------------------

# The API's connection (async driver). "@" inside the password must be %40.
DATABASE_URL=postgresql+asyncpg://aiadmin:PASSWORD_WITH_%40_ENCODED@192.168.15.21:5432/aipnicmp

# The same database with the sync driver. Alembic uses only this one; without
# it, migrations fall back to localhost — which inside a container is the
# container itself — and the migrate service exits 1.
DATABASE_URL_SYNC=postgresql+psycopg://aiadmin:PASSWORD_WITH_%40_ENCODED@192.168.15.21:5432/aipnicmp

# Salts the client-IP hashes, and signs the sign-in session cookies. Anyone who
# learns this value can mint a session for any account, so it must be random and
# must not be shared between environments. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# --- Sign in with Google -------------------------------------------------
# One OAuth client shared by both sites (web and client are the same Google
# app, same backend, same users table). Google Cloud Console → Credentials →
# OAuth client ID → Web application, with BOTH deployment URLs under
# "Authorised JavaScript origins" — e.g. https://aipn.chax.site AND
# https://map.chax.site. Public by design. The consent screen must be
# Published, not left in Testing, or only pre-added test-user emails can
# sign in at all — see docs/deploy.md's "Sign in with Google" section.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# Optional second route in: Firebase Authentication. The bare project id, which
# is the audience every Firebase token is checked against. Empty refuses them
# all. See deploy.md, "Sign in through Firebase, as well".
FIREBASE_PROJECT_ID=

# Who may approve everybody else, comma-separated. Without at least one address
# here, nobody can ever be approved. Signing in on `client` never grants this
# or any elevated access regardless of who is listed here — see
# client/README.md.
SUPER_ADMIN_EMAILS=you@example.la

# Leave true. False disables sign-in entirely and serves the platform to anyone.
AUTH_ENABLED=true

# Guards POST /admin/rebuild-tiles. Leaving it empty keeps that endpoint closed,
# which is the safe default rather than the broken one.
ADMIN_TOKEN=CHANGE_ME

# Where a browser will open each site — not the database, not the container.
# Exactly what goes in the address bar, no trailing slash. Comma-separate
# BOTH sites. Change to https://... once TLS is in front.
CORS_ORIGINS=http://YOUR_SERVER_IP:8090,http://YOUR_SERVER_IP:8091

# --- Optional: omit unless you need to change them ------------------------

# WEB_PORT=8090
# CLIENT_PORT=8091
# BACKEND_IMAGE=ghcr.io/tsabxyooj2018/aipnicmp-backend:latest
# WEB_IMAGE=ghcr.io/tsabxyooj2018/aipnicmp-web:latest
# CLIENT_IMAGE=ghcr.io/tsabxyooj2018/aipnicmp-client:latest
# REDIS_URL=redis://redis:6379/0
# ENV=production
# LOG_LEVEL=INFO
# TILE_MIN_DEVICES=2

# Leave this true. False accepts unsigned records, which defeats the
# capture-time signing the whole anti-spoofing design rests on.
# REQUIRE_RECORD_SIGNATURE=true
