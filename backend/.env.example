# Copy to backend/.env and fill in. Never commit the filled file.

# --- Database (you provide) ---------------------------------------------
# Async driver for the API. Must point at a PostgreSQL 14+ database with the
# postgis extension available to the connecting role.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/aipnicmp
# Sync URL for Alembic migrations — same database, psycopg driver.
DATABASE_URL_SYNC=postgresql+psycopg://USER:PASSWORD@HOST:5432/aipnicmp

# --- Redis / Celery (you provide, optional for phase 1) -----------------
REDIS_URL=redis://localhost:6379/0

# --- App ----------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# --- Ingestion limits ---------------------------------------------------
# Max measurement records accepted in one batch upload.
MAX_BATCH_RECORDS=1000
# Reject records claiming travel faster than this between consecutive points.
MAX_PLAUSIBLE_SPEED_MPS=90
# Reject records with GPS accuracy worse than this.
MAX_GPS_ACCURACY_M=100
# Reject records captured further in the past than this (days).
MAX_RECORD_AGE_DAYS=30

# --- Security -----------------------------------------------------------
# Require every record to carry a valid Ed25519 signature made at capture time.
# Set to false only for local testing with the seed script.
REQUIRE_RECORD_SIGNATURE=true
# Secret used to sign operator/admin dashboard tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=720
# Token for the admin endpoints (tile rebuild). Leave empty to keep them closed.
ADMIN_TOKEN=

# --- Sign in with Google -------------------------------------------------
# Whether the map and dashboard require an approved account. Defaults to true:
# a deployment that forgets to configure sign-in should be closed, not open.
# Set to false only for local development.
AUTH_ENABLED=true

# The OAuth client id from Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → Web application. Public by design: it
# identifies this application to Google and appears in the page.
#
# Add your site to "Authorised JavaScript origins" — e.g. https://aipn.chax.site
# and http://localhost:5173 for development. No client secret is needed; the
# browser performs the sign-in and the server only verifies the signature.
GOOGLE_CLIENT_ID=

# Who may approve everybody else, comma-separated. These addresses become
# approved super admins on first sign-in.
#
# WITHOUT AT LEAST ONE, NOBODY CAN EVER BE APPROVED — the first super admin
# cannot approve themselves into existence. Set this before the first sign-in.
SUPER_ADMIN_EMAILS=you@example.la

# --- Aggregation --------------------------------------------------------
# H3 resolution for the public map. 7 ≈ 5 km² hexes, 8 ≈ 0.7 km².
H3_RESOLUTION=8
# Minimum distinct devices contributing to a tile before it is shown publicly
# (k-anonymity guard).
TILE_MIN_DEVICES=2
