<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ACCESS_FINE_LOCATION is required for getAllCellInfo(), not only for GPS:
      Android treats visible cell identifiers as location data.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Sampling continues while the phone is in a pocket on a bus, so collection
      must survive the app leaving the foreground. From Android 10 this needs
      background location, which is requested separately and only after fine
      location has been granted.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Collection should resume after a reboot on a partner's dedicated phone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      A partial wake lock, held for the length of one sample.

      The foreground service keeps the process alive; it does not keep the
      processor awake once the screen is off. Without this the work handed to
      the sampling thread can be suspended before it runs.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Lets the app ask to be left out of battery optimisation.

      Doze and App Standby defer exactly what this app does, and several vendor
      ROMs stop foreground services outright regardless of what Android says.
      A collector who has been asked to carry a phone for a week cannot be
      expected to know that.

      Only ever *asked* — the system dialog is the user's decision, and the app
      works without it, just less reliably while the screen is off. Note that
      Play restricts this permission to apps whose core function needs it; this
      one is distributed to partner collectors directly (docs/setup.md).
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Telephony is essential; a tablet with no modem cannot collect anything. -->
    <uses-feature android:name="android.hardware.telephony" android:required="true" />
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />

    <application
        android:name=".CollectorApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Collector">

        <!--
          locale and layoutDirection are handled here rather than by the system.

          Without this, changing the language destroys and rebuilds the whole
          activity: the screen blanks, scroll position is lost and a collector
          watching a live count sees it flicker. AppCompat checks this
          declaration and, when the activity claims the change, delivers
          onConfigurationChanged instead of recreating — so the labels are
          re-read in place and nothing else moves.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RecordsActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!--
          Lets AppCompat remember the chosen language on Android 12 and below,
          where the system has no per-app language setting. Most phones a
          collector will be handed are in that range.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".collect.CollectionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".collect.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
