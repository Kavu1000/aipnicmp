<?xml version="1.0" encoding="utf-8"?>
<!--
  The same mark as the dashboard's tab icon: one H3 hexagon, banded in the
  coverage colours. The collector app and the map are one platform, and a
  collector who has both open should not have to be told that.

  Geometry is fixed to the adaptive-icon safe zone rather than eyeballed. The
  canvas is 108dp but launchers may crop to the middle 72dp and mask it to a
  circle, squircle or rounded square depending on the device. The hexagon's
  circumradius is 34dp, so it spans 68dp across — inside the 72dp circle on
  every mask, with nothing important near an edge that might be cut.

  Three explicit band polygons rather than a rectangle behind a clip-path:
  clipping in a VectorDrawable is supported but unantialiased on older
  versions, which would leave the diagonals visibly stepped on exactly the
  cheap handsets this app is built for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Good service. -->
    <path
        android:fillColor="#1F9D55"
        android:pathData="M54,20 L83.44,37 L83.44,43.38 L24.56,43.38 L24.56,37 Z" />

    <!-- Usable but weak. -->
    <path
        android:fillColor="#E3B505"
        android:pathData="M24.56,43.38 L83.44,43.38 L83.44,64.62 L24.56,64.62 Z" />

    <!-- No service. -->
    <path
        android:fillColor="#C1121F"
        android:pathData="M24.56,64.62 L83.44,64.62 L83.44,71 L54,88 L24.56,71 Z" />

    <!-- Keeps the silhouette legible where the red band meets the dark field. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.9"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,20 L83.44,37 L83.44,71 L54,88 L24.56,71 L24.56,37 Z" />
</vector>
