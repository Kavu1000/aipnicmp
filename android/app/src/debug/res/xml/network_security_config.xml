<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Overrides the release policy in app/src/main/res/xml/.

  Allows plain HTTP to private network addresses so a test phone can reach a
  backend running on a laptop over the same wifi. Public hosts still require
  TLS, so a debug build pointed at the real server cannot silently downgrade.

  This file is never part of a release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!--
      Only the loopback addresses an emulator uses. A specific laptop's wifi
      address used to be listed here; it is gone, along with the build default
      that pointed at it. Both were how a handset ended up collecting nothing
      while looking like it was working.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator's view of the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
