# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local config
.env
.env.local
*.pem
*.key
!*.pub.pem

# Data and models
# Anchored to the repository root on purpose. An unanchored "data/" matches a
# directory of that name at any depth, and it silently swallowed the Android
# app's own la.aipnicmp.collector.data package — the code compiled locally and
# failed in CI with "Unresolved reference 'data'".
/data/
*.tif
*.tiff
*.hgt
*.parquet
ml/artifacts/
ml/.cache/

# Node / web
node_modules/
web/dist/
web/.vite/

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.keystore
*.jks

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Android Studio generates this with machine-local SDK paths
android/local.properties
android/.idea/
